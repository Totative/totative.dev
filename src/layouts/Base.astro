---
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css'
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css'
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css'
import '../styles/e.css'
import Brand from '../components/Brand.astro'
import Head from '../components/Head.astro'
import { definition, links, tagline } from '../data/site.ts'

interface Props {
  title?: string
  description?: string
  path?: string
  /** Shows the reading progress line; the page marks what is being read with `data-progress`. */
  progress?: boolean
}

const { title, description, path = '', progress = false } = Astro.props
const inWriteups = path.startsWith('writeups/')
const inBrand = path === 'brand/'
const pageTitle = title ? `${title} - Totative` : 'Totative'
const pageDescription = description ?? tagline
const pageUrl = new URL(path, 'https://totative.dev/').href
const ogType = progress ? 'article' : 'website'
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/atom+xml" title="Totative write-ups" href="/writeups/feed.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Totative" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://totative.dev/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Totative" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {progress && <div class="progress" aria-hidden="true" />}
    <header class="head shell">
      <a class="logo" href="/" aria-label="Totative home"><Brand kind="wordmark" /></a>
      <nav aria-label="Site">
        <a href="/writeups/" aria-current={inWriteups ? 'page' : undefined}>Write-ups</a>
        <a class="wide" href="/brand/" aria-current={inBrand ? 'page' : undefined}>Brand</a>
        <a class="wide" href={links.policy}>Report a vulnerability</a>
        <a class="wide" href={links.github}>GitHub</a>
        <a href={links.disclosure}>Disclosure policy</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="shell">
      <div class="foot">
        <p set:html={definition} />
        <nav aria-label="Footer">
          <a href="/writeups/">Write-ups</a>
          <a href="/brand/">Brand</a>
          <a href={links.policy}>Report a vulnerability</a>
          <a href={links.disclosure}>Disclosure policy</a>
          <a href={links.repositories}>Repositories</a>
          <a href={links.advisories}>Advisories</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/site.ts'
    </script>
  </body>
</html>
