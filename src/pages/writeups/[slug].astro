---
import { render } from 'astro:content'
import { links } from '../../data/site.ts'
import Base from '../../layouts/Base.astro'
import { type Writeup, writeupPaths } from '../../lib/writeups.ts'

export const getStaticPaths = writeupPaths

interface Props {
  writeup: Writeup
}

const { writeup } = Astro.props
const { title, description } = writeup.entry.data
const { Content, headings } = await render(writeup.entry)
---

<Base title={title} description={description} path={`writeups/${writeup.slug}/`} progress>
  <article class="shell page post" data-progress>
    <header class="page-head">
      <p class="crumb"><a href="/writeups/">Write-ups</a></p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="meta"><time datetime={writeup.date}>{writeup.date}</time>, {writeup.minutes} min read</p>
    </header>
    <nav class="contents" aria-label="On this page">
      <p>On this page</p>
      <ol>
        {
          headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))
        }
      </ol>
    </nav>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-end">
      <a class="btn" href={links.policy}>Report a vulnerability</a>
      <a class="btn btn-quiet" href={links.disclosure}>Disclosure policy</a>
      <a href="/writeups/">All write-ups</a>
    </footer>
  </article>
</Base>

<script>
  import '../../scripts/post.ts'
</script>
