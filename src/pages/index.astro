---
import Base from '../layouts/Base.astro'
import { checks, links, noWriteups, reportVulnerability, services, tagline, tools } from '../data/site'
import { SIGHT_LIMIT } from '../lib/e-lattice'
import { getWriteups } from '../lib/writeups'

const writeups = (await getWriteups()).slice(0, 3)
const comma = tagline.indexOf(', ')
const lead = comma === -1 ? tagline : tagline.slice(0, comma)
const rest = comma === -1 ? '' : tagline.slice(comma + 2)
const [example] = tools
const exampleCheck = `${example.download}\n${example.verify}`
const [tarball, bundle, sbom] = example.assets
---

<Base>
  <section class="hero" aria-labelledby="tagline">
    <div class="shell hero-in">
      <div class="hero-copy">
        <h1 id="tagline"><strong>{lead}{rest ? ',' : ''}</strong>{rest ? ` ${rest}` : ''}</h1>
        <p class="actions">
          <a class="btn" href={links.policy}>Report a vulnerability</a>
          <a class="btn btn-quiet" href={links.disclosure}>Disclosure policy</a>
        </p>
      </div>
      <canvas tabindex="0" role="application" aria-label="Lattice. Arrow keys move the viewpoint." aria-describedby="lattice-note"></canvas>
      <div class="hero-eye" aria-hidden="true"></div>
      <div class="hero-note">
        <p id="lattice-note">Each lit dot is in line of sight from the ringed point: their two offsets share no factor but 1.</p>
        <p class="live">
          From <span data-say="view">(0, 0)</span>, <span data-say="sight"></span> of <span data-say="points"></span> dots are in sight, a share of <span data-say="share"
          ></span>; the limit is 6/π², about {SIGHT_LIMIT.toFixed(3)}.
        </p>
      </div>
    </div>
  </section>

  <div class="shell">
    <section class="block" aria-labelledby="services-h">
      <h2 id="services-h">What we do</h2>
      <ul class="services">
        {
          services.map((service) => (
            <li>
              <h3>{service.name}</h3>
              <p>{service.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="tools-h">
      <h2 id="tools-h">Tools</h2>
      <ul class="tools">
        {
          tools.map((tool) => (
            <li>
              <h3>
                <a href={tool.href}>{tool.name}</a>
                <a class="version" href={tool.release} aria-label={`${tool.name} release ${tool.version}`}>
                  {tool.version}
                </a>
              </h3>
              <p>{tool.summary}</p>
              <p class="cmd">
                <code>{tool.install}</code>
                <button type="button" data-copy={tool.install}>
                  Copy
                </button>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="check-h">
      <h2 id="check-h">What you can check</h2>
      <div>
        <ul class="checks">
          {checks.map((check) => <li set:html={check} />)}
        </ul>
        <p class="example">For example, {example.name} {example.version}:</p>
        <p class="cmd">
          <code>{exampleCheck}</code>
          <button type="button" data-copy={exampleCheck}>Copy</button>
        </p>
        <p class="files">
          Each release carries three files: the source tarball ({tarball}), its provenance bundle ({bundle}) and the SBOM ({sbom}).
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="posts-h">
      <h2 id="posts-h">Latest write-ups</h2>
      <div>
        {
          writeups.length > 0 ? (
            <ul class="posts">
              {writeups.map((writeup) => (
                <li>
                  <h3>
                    <a href={`/writeups/${writeup.slug}/`}>{writeup.entry.data.title}</a>
                  </h3>
                  <p>{writeup.entry.data.description}</p>
                  <p class="meta">
                    <time datetime={writeup.date}>{writeup.date}</time>, {writeup.minutes} min read
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p set:html={noWriteups} />
          )
        }
        <p class="more"><a href="/writeups/">All write-ups</a></p>
      </div>
    </section>

    <section class="block" aria-labelledby="report-h">
      <h2 id="report-h">Report a vulnerability</h2>
      <div>
        <p set:html={reportVulnerability} />
        <p class="actions">
          <a class="btn" href={links.policy}>Report a vulnerability</a>
          <a class="btn btn-quiet" href={links.disclosure}>Disclosure policy</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { mountLattice } from '../scripts/lattice'

  const hero = document.querySelector<HTMLElement>('.hero')
  if (hero) mountLattice(hero)
</script>
