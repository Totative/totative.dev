---
import wordmarkSvg from '../assets/brand/totative-wordmark-dark.svg?raw'

// Fills become classes so the stylesheet colours the wordmark. Clip-path ids
// are prefixed so they stay unique if another SVG on the page reuses the names.
const svg = wordmarkSvg
  .replace(/ width="\d+" height="\d+"/, ' class="brand"')
  .replaceAll('fill="#F2EEF8"', 'class="wm-ink"')
  .replaceAll('fill="#B26BFF"', 'class="wm-accent"')
  .replaceAll(/(id="|url\(#)(above|below)/g, '$1wordmark-$2')
---

<Fragment set:html={svg} />
