---
import { type DesignId, designs } from '../data/site'

interface Props {
  /** Left out on a page that is not one of the designs. */
  current?: DesignId
  /** The page's path below the design root, so each link opens the same page in another design. */
  path?: string
}

const { current, path = '' } = Astro.props
---

<nav class="mockbar" aria-label="Design mocks">
  <a href="/">Mocks</a>
  {
    designs.map((design) => (
      <a href={`/${design.id}/${path}`} aria-current={design.id === current ? 'page' : undefined} title={design.name}>
        {design.id.toUpperCase()}
        <span>{design.name}</span>
      </a>
    ))
  }
  <a href="/lab/f-animation/" aria-current={Astro.url.pathname.startsWith('/lab/') ? 'page' : undefined}>Lab<span>dial</span></a>
</nav>

<style>
  /* One line at every width: the designs can count on the strip being 32px tall. */
  .mockbar {
    position: relative;
    z-index: 1000;
    display: flex;
    gap: 14px;
    height: 32px;
    align-items: center;
    padding: 0 16px;
    overflow: hidden;
    white-space: nowrap;
    background: #000;
    color: #9a9a9a;
    font: 500 12px/1 system-ui, sans-serif;
    border-bottom: 1px solid #2a2a2a;
    view-transition-name: none;
  }
  .mockbar a {
    color: inherit;
    text-decoration: none;
  }
  .mockbar span {
    margin-left: 0.3em;
  }
  .mockbar a:hover,
  .mockbar a[aria-current] {
    color: #fff;
  }
  .mockbar a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  @media (max-width: 900px) {
    .mockbar span {
      display: none;
    }
    .mockbar a[aria-current] span {
      display: inline;
    }
  }
</style>
