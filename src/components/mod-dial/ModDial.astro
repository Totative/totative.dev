---
// The multiplication dial, on its own: a chord from each residue k to m·k mod n.
// Drop it into any layout. It brings its markup, styles and script, and takes its
// colours and faces from the --dial-* custom properties, which a host can override.
//
// A host page can drive it:  root.dispatchEvent(new CustomEvent('moddial:show', { detail: { n, m, label, note } }))
// and listen to it:          root.addEventListener('moddial:change', (event) => event.detail)  // { n, m, reached }
import type { DialPreset } from './mount'
import { DIAL_MAX, DIAL_MIN, describe, dialSvg, reached } from './maths'

interface Props {
  /** Pairs the dial can show. The first is the starting pair. */
  presets: readonly [DialPreset, ...DialPreset[]]
  /** Seconds between presets while the dial is on screen and untouched. 0 leaves it still. */
  cycle?: number
  /** Buttons for the presets, sliders, steppers and play. Without them the dial is a picture a host drives. */
  controls?: boolean
  class?: string
}

const { presets, cycle = 0, controls = true, class: className } = Astro.props
const [first] = presets
const { n, m } = first
// The filled part of each slider's track, which the script keeps up to date after this first paint.
const fill = (value: number, min: number, max: number) => `--fill: ${max > min ? ((value - min) / (max - min)) * 100 : 100}%`
---

<section
  class:list={['mod-dial', className]}
  data-mod-dial
  data-n={n}
  data-m={m}
  data-presets={JSON.stringify(presets)}
  data-cycle={cycle}
  aria-label="Multiplication dial"
>
  <p class="dial-label" data-dial-label>{first.label ?? ''}</p>
  <div class="dial-face">
    <svg class="dial-static" viewBox="-120 -120 240 240" aria-hidden="true" set:html={dialSvg(n, m)} />
    <canvas data-dial-canvas aria-hidden="true"></canvas>
  </div>
  <p class="dial-map">
    <span class="dial-rule"><i>k</i> → <b data-dial-m>{m}</b><i>k</i> mod <b data-dial-n>{n}</b></span>
    <span class="dial-count"><b data-dial-reached>{reached(n, m)}</b> of <span data-dial-n>{n}</span> reached</span>
  </p>
  <p class="dial-status" data-dial-status aria-live="off">{describe(n, m)}</p>
  <p class="dial-note" data-dial-note>{first.note ?? ''}</p>
  <div class="dial-controls" hidden={!controls}>
    {
      presets.length > 1 && (
        <div class="dial-presets" role="group" aria-label="Pairs to show">
          {presets.map((preset, index) => (
            <button type="button" data-dial-preset={index} aria-pressed={index === 0 ? 'true' : 'false'}>
              {preset.label ?? `${preset.n}, ${preset.m}`}
            </button>
          ))}
        </div>
      )
    }
    <div class="dial-fields">
      <div class="dial-field">
        <i>n</i>
        <button type="button" data-dial-step="n:-1" aria-label="n down by 1">−</button>
        <input data-dial-input="n" type="range" min={DIAL_MIN} max={DIAL_MAX} value={n} style={fill(n, DIAL_MIN, DIAL_MAX)} aria-label="n, the modulus" />
        <button type="button" data-dial-step="n:1" aria-label="n up by 1">+</button>
      </div>
      <div class="dial-field">
        <i>m</i>
        <button type="button" data-dial-step="m:-1" aria-label="m down by 1">−</button>
        <input data-dial-input="m" type="range" min="1" max={n - 1} value={m} style={fill(m, 1, n - 1)} aria-label="m, the multiplier" />
        <button type="button" data-dial-step="m:1" aria-label="m up by 1">+</button>
      </div>
    </div>
    <button type="button" class="dial-play" data-dial-play aria-pressed="false">Play</button>
  </div>
  <p class="dial-alt">
    The picture: the residues 0 to <i>n</i> − 1 round a circle, with a line from each <i>k</i> to <i>m</i>·<i>k</i> mod <i>n</i>.{
      controls && ' Drag on the dial to set m, or point at a residue to see where it lands.'
    }
  </p>
</section>

<script>
  import { mountDial } from './mount'

  for (const root of document.querySelectorAll<HTMLElement>('[data-mod-dial]')) mountDial(root)
</script>

<style is:global>
  .mod-dial {
    --dial-from: #ff3d81;
    --dial-to: #ff9a3d;
    --dial-ink: #f5f1ee;
    --dial-muted: #a8a09c;
    --dial-line: #322b2d;
    --dial-ground: #000;
    --dial-sans: 'Atkinson Hyperlegible Next Variable', system-ui, sans-serif;
    --dial-mono: 'Atkinson Hyperlegible Mono Variable', ui-monospace, monospace;
    --dial-grad: linear-gradient(100deg, var(--dial-from), var(--dial-to));
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--dial-ink);
    font: 400 1rem / 1.5 var(--dial-sans);
  }
  .mod-dial p {
    margin: 0;
  }
  .mod-dial i {
    font-style: italic;
  }
  .mod-dial :focus-visible {
    outline: 2px solid var(--dial-to);
    outline-offset: 3px;
  }

  .mod-dial .dial-label {
    min-height: 1.2em;
    font: 500 0.8125rem / 1.2 var(--dial-mono);
    color: var(--dial-muted);
  }

  .mod-dial .dial-face {
    position: relative;
    width: min(100%, var(--dial-size, 30rem));
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .mod-dial .dial-face::before {
    content: '';
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--dial-from) 30%, transparent),
      color-mix(in srgb, var(--dial-to) 10%, transparent) 62%,
      transparent
    );
    filter: blur(34px);
    transition: opacity 0.6s;
  }
  .mod-dial.is-colliding .dial-face::before {
    opacity: 0.35;
  }
  .mod-dial .dial-static,
  .mod-dial canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mod-dial canvas {
    touch-action: pan-y;
    cursor: grab;
  }
  .mod-dial canvas:active {
    cursor: grabbing;
  }
  .mod-dial[data-live] .dial-static {
    visibility: hidden;
  }

  .mod-dial .dial-static line {
    stroke: color-mix(in srgb, var(--dial-from), var(--dial-to) var(--mix, 50%));
    stroke-width: 0.6;
    mix-blend-mode: screen;
  }
  .mod-dial .dial-static .dial-rim {
    fill: none;
    stroke: color-mix(in srgb, var(--dial-ink) 10%, transparent);
    stroke-width: 0.5;
  }
  .mod-dial .dial-static .dial-hit {
    fill: var(--dial-ink);
  }
  .mod-dial .dial-static .dial-miss {
    fill: none;
    stroke: color-mix(in srgb, var(--dial-muted) 45%, transparent);
    stroke-width: 0.5;
  }
  .mod-dial .dial-static .dial-one {
    stroke: var(--dial-ink);
    stroke-width: 1;
    mix-blend-mode: normal;
  }
  .mod-dial .dial-static .dial-knob {
    fill: var(--dial-ground);
    stroke: var(--dial-ink);
  }
  .mod-dial .dial-static .dial-num {
    font: 500 6px var(--dial-mono);
    fill: color-mix(in srgb, var(--dial-ink) 80%, transparent);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .mod-dial .dial-map {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    font-family: var(--dial-mono);
  }
  .mod-dial .dial-rule {
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .mod-dial .dial-rule i {
    font-style: normal;
    color: var(--dial-muted);
  }
  .mod-dial .dial-rule b,
  .mod-dial .dial-count b {
    background: var(--dial-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mod-dial .dial-count {
    font-size: 0.875rem;
    color: var(--dial-muted);
  }
  .mod-dial .dial-count b {
    font-size: 1.125rem;
  }
  .mod-dial .dial-status {
    min-height: 4.5em;
    font-weight: 600;
  }
  .mod-dial .dial-note {
    min-height: 2.9em;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--dial-muted);
  }

  .mod-dial .dial-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 20px;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--dial-line);
  }
  .mod-dial:not([data-live]) .dial-controls {
    visibility: hidden;
  }
  .mod-dial .dial-controls[hidden] {
    display: none;
  }
  .mod-dial .dial-presets {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-bottom: 8px;
  }
  .mod-dial .dial-presets button {
    padding: 6px 12px;
    border: 1px solid var(--dial-line);
    border-radius: 999px;
    background: none;
    color: var(--dial-muted);
    font: 500 0.8125rem / 1.2 var(--dial-sans);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .mod-dial .dial-presets button:hover {
    color: var(--dial-ink);
  }
  .mod-dial .dial-presets button[aria-pressed='true'] {
    border-color: var(--dial-to);
    color: var(--dial-ink);
  }
  .mod-dial .dial-fields {
    grid-column: 1;
    display: grid;
    gap: 4px;
  }
  .mod-dial .dial-field {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mod-dial .dial-field i {
    width: 1.1em;
    font-size: 1.125rem;
    font-weight: 700;
  }
  .mod-dial .dial-field button {
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--dial-line);
    border-radius: 50%;
    background: none;
    color: var(--dial-ink);
    font: 600 1rem / 1 var(--dial-mono);
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .mod-dial .dial-field button:hover {
    border-color: var(--dial-to);
  }
  .mod-dial .dial-field input {
    flex: 1;
    min-width: 0;
    height: 32px;
    margin: 0;
    appearance: none;
    background: none;
    cursor: pointer;
  }
  .mod-dial .dial-field input::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background:
      var(--dial-grad) 0 / var(--fill, 50%) 100% no-repeat,
      var(--dial-line);
  }
  .mod-dial .dial-field input::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -7px;
    border-radius: 50%;
    background: var(--dial-ink);
  }
  .mod-dial .dial-field input::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: var(--dial-line);
  }
  .mod-dial .dial-field input::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--dial-grad);
  }
  .mod-dial .dial-field input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 50%;
    background: var(--dial-ink);
  }
  .mod-dial .dial-play {
    grid-column: 2;
    width: 76px;
    height: 76px;
    border: 0;
    border-radius: 50%;
    background: var(--dial-grad);
    color: var(--dial-ground);
    font: 750 0.9375rem / 1 var(--dial-sans);
    cursor: pointer;
  }
  .mod-dial .dial-play[aria-pressed='true'] {
    background: none;
    color: var(--dial-ink);
    box-shadow: inset 0 0 0 2px var(--dial-to);
  }
  .mod-dial .dial-alt {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--dial-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .mod-dial * {
      transition: none;
    }
  }
</style>
