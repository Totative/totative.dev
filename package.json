{
  "name": "totative.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "astro sync && tsc -b --noEmit --pretty false",
    "check": "bunx -p typescript@6.0.3 -p @astrojs/check@0.9.12 astro-check",
    "scan": "mkdir -p scan-out && uv run --with playwright python scripts/scan_runtime.py http://127.0.0.1:4321 scan-out"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "astro": "^7.4.8",
    "shiki": "^4.6.0",
    "typescript": "7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6"
  }
}
